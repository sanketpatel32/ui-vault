// One-shot: generate src/data/components/{bklit,pdfcn,remocn,assistantui}.ts and the
// @oidc block of shadcn (src/data/components/shadcn-oidc.ts) from research/*.json.
// Registry entries only — no previewKey (no vendored previews for these sources).
// Run: npx tsx scripts/gen-v08.mts [bklit|pdfcn|remocn|assistantui|oidc ...]
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const root = join(import.meta.dirname, "..");
const read = (p: string) => JSON.parse(readFileSync(join(root, p), "utf8"));
const q = (s: string) => JSON.stringify(s);
const kebab = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

interface Gen {
  id: string;
  name: string;
  description: string;
  source: string;
  sourceUrl: string;
  sourceCategory: string;
  category: string;
  tags: string[];
  install: string;
  featured?: boolean;
}

function entry(e: Gen): string {
  return [
    "  {",
    `    id: ${q(e.id)},`,
    `    name: ${q(e.name)},`,
    `    description: ${q(e.description)},`,
    `    source: ${q(e.source)},`,
    `    sourceUrl: ${q(e.sourceUrl)},`,
    `    sourceCategory: ${q(e.sourceCategory)},`,
    `    category: ${q(e.category)},`,
    `    tags: [${e.tags.map(q).join(", ")}],`,
    `    license: "mit",`,
    `    previewMode: "live",`,
    `    install: ${q(e.install)},`,
    ...(e.featured ? ["    featured: true,"] : []),
    "  },",
  ].join("\n");
}

function emit(file: string, exportName: string, header: string[], items: Gen[]) {
  const ids = new Set<string>();
  for (const i of items) {
    if (ids.has(i.id)) throw new Error(`duplicate id ${i.id}`);
    ids.add(i.id);
  }
  const lines = [
    ...header.map((h) => `// ${h}`),
    `// ${items.length} entries.`,
    'import type { UIEntry } from "../types";',
    "",
    `export const ${exportName}: UIEntry[] = [`,
    ...items.map(entry),
    "];",
    "",
  ];
  writeFileSync(join(root, "src/data/components", file), lines.join("\n"));
  console.log(`${file}: ${items.length}`);
}

const want = new Set(process.argv.slice(2));
const run = (k: string) => want.size === 0 || want.has(k);

// ---------- Bklit UI ----------
if (run("bklit")) {
  const d = read("research/bklit.json");
  const CAT: Record<string, string> = {
    Charts: "data-display",
    Utility: "data-display",
    Blocks: "cards",
  };
  emit(
    "bklit.ts",
    "bklit",
    ["Generated by scripts/gen-v08.mts from research/bklit.json (ui.bklit.com/r/registry.json)."],
    d.components.map((c: any) => ({
      id: `bklit-${c.slug}`,
      name: c.name,
      description: c.description,
      source: "bklit",
      sourceUrl: c.url,
      sourceCategory: c.category,
      category: CAT[c.category],
      tags: [
        "bklit",
        "chart",
        "d3",
        c.category === "Utility" ? "chart-utility" : kebab(c.category),
      ],
      install: `npx shadcn@latest add @bklit/${c.slug}`,
      featured: ["line-chart", "sankey-chart", "choropleth-chart", "live-line-chart"].includes(
        c.slug,
      ),
    })),
  );
}

// ---------- pdfcn ----------
if (run("pdfcn")) {
  const d = read("research/pdfcn.json");
  emit(
    "pdfcn.ts",
    "pdfcn",
    [
      "Generated by scripts/gen-v08.mts from research/pdfcn.json (pdfcn.dev/r/registry.json).",
      "Cataloged once per component with the Takumi install; every item also ships as @pdfcn/forme/<name>.",
    ],
    d.components.map((c: any) => ({
      id: `pdfcn-${c.slug}`,
      name: c.category === "Blocks" ? `${c.name} (PDF)` : `PDF ${c.name}`,
      description: `${c.description.replace(/\.?$/, ".")} Forme renderer variant: @pdfcn/forme/${c.slug}.`,
      source: "pdfcn",
      sourceUrl: c.url,
      sourceCategory: c.category,
      category: "pdf",
      tags: ["pdfcn", "pdf", "takumi", "forme", c.category === "Blocks" ? "template" : "primitive"],
      install: `npx shadcn@latest add @pdfcn/takumi/${c.slug}`,
      featured: ["invoice-modern", "data-table"].includes(c.slug),
    })),
  );
}

// ---------- Remocn ----------
if (run("remocn")) {
  const d = read("research/remocn.json");
  emit(
    "remocn.ts",
    "remocn",
    [
      "Generated by scripts/gen-v08.mts from research/remocn.json (remocn.dev/llms-components.txt + /r/registry.json).",
      "Every entry needs Remotion — these render video frames, not interactive web UI.",
    ],
    d.components.map((c: any) => ({
      id: `remocn-${c.slug}`,
      name: c.name,
      description: c.description,
      source: "remocn",
      sourceUrl: c.url,
      sourceCategory: c.category,
      category: "video",
      tags: [...new Set(["remotion", kebab(c.category), ...(c.vibe ? [kebab(c.vibe)] : [])])],
      install: `npx shadcn@latest add @remocn/${c.slug}`,
      featured: ["soft-blur-in", "agent-run", "zoom-blur", "ai-prompt-flow"].includes(c.slug),
    })),
  );
}

// ---------- assistant-ui ----------
if (run("assistantui")) {
  const d = read("research/assistantui.json");
  const CAT: Record<string, string> = {
    "number-roll": "numbers",
    "elements-number-ticker": "numbers",
  };
  emit(
    "assistantui.ts",
    "assistantui",
    [
      "Generated by scripts/gen-v08.mts from research/assistantui.json (r.assistant-ui.com/registry.json).",
      "Runtime components need @assistant-ui/react + a runtime; elements-* are props-driven.",
    ],
    d.components.map((c: any) => ({
      id: `assistantui-${c.slug}`,
      name: c.name,
      description: c.description,
      source: "assistantui",
      sourceUrl: c.url,
      sourceCategory: c.category,
      category: CAT[c.slug] ?? "chat",
      tags: ["assistant-ui", "ai", c.category === "Elements" ? "props-driven" : "runtime"],
      install: `npx shadcn@latest add https://r.assistant-ui.com/${c.slug}`,
      featured: ["thread", "assistant-modal", "elements-tool-call"].includes(c.slug),
    })),
  );
}

// ---------- shadcn OIDC (@oidc) ----------
if (run("oidc")) {
  const d = read("research/shadcn-oidc.json");
  const CAT: Record<string, string> = { claims: "forms", picker: "forms" };
  emit(
    "shadcn-oidc.ts",
    "shadcnOidc",
    [
      "Generated by scripts/gen-v08.mts from research/shadcn-oidc.json (ui.shadcn.com/oidc/r/registry.json).",
      "Part of the shadcn source (@oidc namespace). Providers are family-granularity — 9 form-library variants each.",
    ],
    d.components.map((c: any) => ({
      id: `shadcn-oidc-${c.slug}`,
      name: c.name,
      description: c.variants
        ? `${c.description} Variants: ${c.variants.map((v: string) => `@oidc/${v}`).join(", ")}.`
        : c.description,
      source: "shadcn",
      sourceUrl: c.url,
      sourceCategory: `OIDC ${c.category}`,
      category: CAT[c.slug] ?? "auth",
      tags: ["oidc", "auth", "shadcn", kebab(c.category)],
      install: `npx shadcn@latest add @oidc/${c.slug}`,
      featured: c.slug === "core",
    })),
  );
}
